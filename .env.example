# ---------------- LLM ----------------
# mock | ollama | openai
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=120
 
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible server (LM Studio, vLLM, OpenRouter ...)
OPENAI_BASE_URL=
 
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
 
# ---------------- Database ----------------
# Port 5433 = the port docker-compose publishes on your machine.
DATABASE_DIALECT=postgres
READONLY_DATABASE_URL=postgresql+psycopg://sql_agent_readonly:readonly_pass_123@localhost:5433/sqlagent_demo
WRITER_DATABASE_URL=postgresql+psycopg://sql_agent_writer:writer_pass_456@localhost:5433/sqlagent_demo
 
# ---------------- Schema ----------------
ALLOWED_SCHEMAS=public
DEFAULT_SCHEMA=public
SCHEMA_CACHE_TTL=60
 
# ---------------- Security ----------------
ENABLE_DDL=false
MAX_WRITE_ROWS=100
# EXPLAIN writes (never executed, always rolled back) before asking for approval
LIVE_VALIDATE_WRITES=true
 
# ---------------- Execution ----------------
MAX_RESULT_ROWS=1000
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=2000
 
# ---------------- Agent ----------------
MAX_SQL_REPAIR_ATTEMPTS=2
 
# ---------------- Audit ----------------
AUDIT_LOG_PATH=logs/audit.log
